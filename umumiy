class InviteForm(StatesGroup):
  groom_bride = State()
  event_date = State()
  event_time = State()
  venue = State()
  hosts = State()


def generate_invitation_image(groom_bride, date_str, time_str, venue, hosts):
  width, height = 1200, 800
  img = Image.new("RGB", (width, height), color="#FFFFFF")
  draw = ImageDraw.Draw(img)

  gold_color = "#C59B27"
  gold_light = "#E5C158"
  text_dark = "#4A3319"
  text_gold = "#8C6313"

  draw.rectangle([15, 15, width - 15, height - 15], outline=gold_color, width=4)
  draw.rectangle(
      [25, 25, width - 25, height - 25], outline=gold_light, width=2
  )

  for i in range(0, height, 40):
    draw.line([(5, i), (15, i + 20)], fill=gold_light, width=1)
    draw.line([(width - 5, i), (width - 15, i + 20)], fill=gold_light, width=1)

  try:
    font_large = ImageFont.truetype("arial.ttf", 46)
    font_medium = ImageFont.truetype("arial.ttf", 28)
    font_small = ImageFont.truetype("arial.ttf", 22)
    font_bold = ImageFont.truetype("arialbd.ttf", 36)
  except OSError:
    font_large = font_medium = font_small = font_bold = (
        ImageFont.load_default()
    )

  draw.ellipse([width // 2 - 40, 40, width // 2 + 40, 120], outline=gold_color, width=2)
  draw.text((width // 2 - 25, 60), "S | M", fill=text_gold, font=font_medium)

  draw.text(
      (width // 2, 150),
      "Assalomu Alaykum!",
      fill=text_gold,
      font=font_medium,
      anchor="mm",
  )
  draw.text(
      (width // 2, 190),
      "Hurmatli: Aziz mehmonimiz",
      fill=text_dark,
      font=font_small,
      anchor="mm",
  )
  draw.text(
      (width // 2, 225),
      "Sizni va oila a'zolaringizni farzandlarimiz",
      fill=text_dark,
      font=font_small,
      anchor="mm",
  )

  draw.text(
      (width // 2, 290),
      groom_bride,
      fill=text_gold,
      font=font_large,
      anchor="mm",
  )

  draw.text(
      (width // 2, 360),
      "larning nikoh to'ylari munosabati bilan yoziladigan",
      fill=text_dark,
      font=font_small,
      anchor="mm",
  )
  draw.text(
      (width // 2, 390),
      "bazm dasturxonimizning aziz mehmoni bo'lishga taklif etamiz.",
      fill=text_dark,
      font=font_small,
      anchor="mm",
  )

  draw.rectangle(
      [width // 4 - 120, 450, width // 4 + 120, 520],
      outline=gold_color,
      width=2,
  )
  draw.text(
      (width // 4, 485),
      f"📅 {date_str}",
      fill=text_gold,
      font=font_bold,
      anchor="mm",
  )

  draw.rectangle(
      [(width // 4) * 3 - 120, 450, (width // 4) * 3 + 120, 520],
      outline=gold_color,
      width=2,
  )
  draw.text(
      ((width // 4) * 3, 485),
      f"⏰ {time_str}",
      fill=text_gold,
      font=font_bold,
      anchor="mm",
  )

  draw.text(
      (width // 4, 580),
      f"📍 {venue}",
      fill=text_dark,
      font=font_medium,
      anchor="mm",
  )

  draw.text(
      ((width // 4) * 3, 560),
      "Hurmat bilan:",
      fill=text_dark,
      font=font_small,
      anchor="mm",
  )
  draw.text(
      ((width // 4) * 3, 600),
      hosts,
      fill=text_gold,
      font=font_bold,
      anchor="mm",
  )

  draw.line(
      [width // 2 - 100, 680, width // 2 + 100, 680], fill=gold_color, width=2
  )

  img_byte_arr = io.BytesIO()
  img.save(img_byte_arr, format="PNG")
  img_byte_arr.seek(0)
  return img_byte_arr


@dp.message(Command("start"))
async def cmd_start(message: Message, state: FSMContext):
  await state.clear()
  kb = InlineKeyboardMarkup(
      inline_keyboard=[[
          InlineKeyboardButton(
              text="✨ Premium Taklifnoma Yaratish", callback_data="start_invite"
          )
      ]]
  )
  await message.answer(
      "Assalomu Alaykum! **AktamInvite** botiga xush kelibsiz! 💌\n\nHashamatli"
      " to'y taklifnomasini tayyorlash uchun quyidagi tugmani bosing:",
      reply_markup=kb,
      parse_mode="Markdown",
  )


@dp.callback_query(F.data == "start_invite")
async def start_invite(callback: types.CallbackQuery, state: FSMContext):
  await callback.message.answer(
      "1️⃣ **Kuyov va Kelin ismlarini kiriting:**\n*(Masalan: Sobirbek &"
      " Munisaxon)*",
      parse_mode="Markdown",
  )
  await state.set_state(InviteForm.groom_bride)
  await callback.answer()


@dp.message(InviteForm.groom_bride)
async def process_names(message: Message, state: FSMContext):
  await state.update_data(groom_bride=message.text)
  await message.answer(
      "2️⃣ **To'y sanasini kiriting:**\n*(Masalan: 20 FEVRAL 2025)*",
      parse_mode="Markdown",
  )
  await state.set_state(InviteForm.event_date)


@dp.message(InviteForm.event_date)
async def process_date(message: Message, state: FSMContext):
  await state.update_data(event_date=message.text)
  await message.answer(
      "3️⃣ **Soat va hafta kunini kiriting:**\n*(Masalan: 17:30 PAYSHANBA)*",
      parse_mode="Markdown",
  )
  await state.set_state(InviteForm.event_time)


@dp.message(InviteForm.event_time)
async def process_time(message: Message, state: FSMContext):
  await state.update_data(event_time=message.text)
  await message.answer(
      "4️⃣ **To'yxona va shaharni kiriting:**\n*(Masalan: Termiz, SERENADA"
      " to'yxonasi)*",
      parse_mode="Markdown",
  )
  await state.set_state(InviteForm.venue)


@dp.message(InviteForm.venue)
async def process_venue(message: Message, state: FSMContext):
  await state.update_data(venue=message.text)
  await message.answer(
      "5️⃣ **Taklif etuvchi oila nomini kiriting:**\n*(Masalan: Bekzod aka"
      " Hakimovlar oilasi)*",
      parse_mode="Markdown",
  )
  await state.set_state(InviteForm.hosts)


@dp.message(InviteForm.hosts)
async def process_final(message: Message, state: FSMContext):
  await state.update_data(hosts=message.text)
  data = await state.get_data()

  wait_msg = await message.answer(
      "🎨 **Sizning premium taklifnomangiz chizilmoqda, iltimos biroz"
      " kuting...**"
  )

  image_bytes = generate_invitation_image(
      groom_bride=data["groom_bride"],
      date_str=data["event_date"],
      time_str=data["event_time"],
      venue=data["venue"],
      hosts=data["hosts"],
  )

  input_file = BufferedInputFile(
      image_bytes.read(), filename="taklifnoma.png"
  )
  kb = InlineKeyboardMarkup(
      inline_keyboard=[[
          InlineKeyboardButton(
              text="➕ Yangi taklifnoma yaratish", callback_data="start_invite"
          )
      ]]
  )

  await message.answer_photo(
      photo=input_file,
      caption=(
          "🎉 **Taklifnomangiz tayyor!**\n\nUshbu rasmni yaqinlaringizga"
          " yuborishingiz mumkin."
      ),
      reply_markup=kb,
      parse_mode="Markdown",
  )

  await wait_msg.delete()
  await state.clear()


async def main():
  print("AktamInvite boti muvaffaqiyatli ishga tushdi...")
  await dp.start_polling(bot)


if __name__ == "__main__":
  asyncio.run(main())
